# Google GenAI API Key for Google ADK (Cloud Model option)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Configuration (Gemini Cloud or Local Ollama e.g. ollama/qwen3:8b)
GEMINI_MODEL=gemini-2.5-flash

# Target Application Directory (Default: current workspace)
TARGET_APP_DIR=./

# Target Production Deployment & Health Probes
PROD_APP_URL=https://example.com
PROD_DOMAIN=example.com

# MCP Server Tokens (Optional - enables Supabase, GitHub, and Vercel MCP Toolsets)
SUPABASE_PROJECT_REF=your_supabase_project_ref
SUPABASE_ACCESS_TOKEN=your_supabase_access_token
GITHUB_TOKEN=your_github_token
VERCEL_TOKEN=your_vercel_token

# Optional Third-Party Integration Keys
RESEND_API_KEY=your_resend_api_key
PROD_SUPABASE_URL=https://your-project.supabase.co
PROD_SUPABASE_ANON_KEY=your_supabase_anon_key
